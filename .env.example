# ===== App =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Banco (PostgreSQL) =====
# Produção (Neon/Supabase): use um usuário com permissão mínima e SSL obrigatório
# DATABASE_URL="postgresql://vertice_app:SENHA@ep-xxx.sa-east-1.aws.neon.tech/vertice?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vertice"

# ===== Auth.js (NextAuth v5) =====
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Google OAuth (opcional) - https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Chave para criptografar segredos TOTP (2FA) no banco. 32 bytes em base64:
# openssl rand -base64 32
ENCRYPTION_KEY=""

# ===== Stripe (MODO TESTE) =====
# Sem STRIPE_SECRET_KEY o app usa pagamento SIMULADO (apenas fora de produção)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===== Resend (email) =====
# Sem RESEND_API_KEY os emails são apenas registrados no log (mascarados)
RESEND_API_KEY=""
EMAIL_FROM="VÉRTICE <onboarding@resend.dev>"

# ===== Upstash Redis (rate limiting) =====
# Sem estas variáveis, usa limitador em memória (ok para dev, NÃO para produção multi-instância)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===== Cloudinary (upload de imagens - admin) =====
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ===== Seed =====
SEED_ADMIN_EMAIL="admin@vertice.dev"
SEED_ADMIN_PASSWORD="Admin@Vertice2026"
